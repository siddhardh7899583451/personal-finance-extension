{
  "name": "personal-finance-expense-intelligence",
  "version": "1.0.0",
  "description": "Personal Finance & Expense Intelligence - Production Chrome Extension (Manifest V3)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "build:vite": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "date-fns": "^3.3.1",
    "uuid": "^9.0.1",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.2.2",
    "prettier": "^3.2.5",
    "eslint": "^8.56.0",
    "esbuild": "^0.21.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
