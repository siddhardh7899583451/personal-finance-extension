{
  "manifest_version": 3,
  "name": "Personal Finance & Expense Intelligence",
  "short_name": "Finance Intelligence",
  "version": "1.0.0",
  "description": "Local-first personal finance tracker with advanced spending analytics, budgets, savings goals, and reports. Your data never leaves your device.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Finance Intelligence",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms"],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  }
}
